{
  "name": "x-trends-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "X/Twitter 热榜监控与翻译输出 MVP 骨架",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:radar": "tsc -p tsconfig.radar.json",
    "radar:bootstrap": "tsx scripts/bootstrap-radar.ts",
    "radar:connect": "tsx scripts/connect-github-radar.ts",
    "radar:dry-run": "tsx scripts/run-radar.ts --dry-run --fixtures",
    "radar:run": "tsx scripts/run-radar.ts",
    "test:upgrade:ps1": "powershell -ExecutionPolicy Bypass -File scripts/test-upgrade.ps1",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
